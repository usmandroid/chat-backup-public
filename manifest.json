{
  "manifest_version": 2,
  "name": "ChatGPT Backup",
  "version": "1.0",
  "description": "Save ChatGPT conversations as Markdown or HTML",
  "permissions": ["tabs", "activeTab"],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"]
    }
  ]
}
